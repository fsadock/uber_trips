*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Segredos: cookies da Uber, OAuth do Gmail, service account do Google Sheets.
# O padrão antigo era `.json`, que casa só com um arquivo chamado ".json" e
# portanto nunca ignorou nada.
.env
.env.*
!.env.example
*.json
credentials.json
token.json

